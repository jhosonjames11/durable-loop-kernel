{
  "name": "loopgraph-supervisor",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "loopgraph-supervisor",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "6.0.3"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@loopgraph/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@loopgraph/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@loopgraph/demo": {
      "resolved": "packages/demo",
      "link": true
    },
    "node_modules/@loopgraph/dsh-adapter": {
      "resolved": "packages/dsh-adapter",
      "link": true
    },
    "node_modules/@loopgraph/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "node_modules/typescript": {
      "version": "6.0.3",
      "resolved": "https://registry.npmmirror.com/typescript/-/typescript-6.0.3.tgz",
      "integrity": "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/cli": {
      "name": "@loopgraph/cli",
      "version": "0.1.0",
      "dependencies": {
        "@loopgraph/core": "file:../core",
        "@loopgraph/storage": "file:../storage"
      },
      "bin": {
        "loopgraph": "dist/index.js"
      }
    },
    "packages/core": {
      "name": "@loopgraph/core",
      "version": "0.1.0"
    },
    "packages/demo": {
      "name": "@loopgraph/demo",
      "version": "0.1.0",
      "dependencies": {
        "@loopgraph/core": "0.1.0",
        "@loopgraph/storage": "0.1.0"
      }
    },
    "packages/dsh-adapter": {
      "name": "@loopgraph/dsh-adapter",
      "version": "0.1.0"
    },
    "packages/storage": {
      "name": "@loopgraph/storage",
      "version": "0.1.0",
      "dependencies": {
        "@loopgraph/core": "file:../core"
      }
    }
  }
}
